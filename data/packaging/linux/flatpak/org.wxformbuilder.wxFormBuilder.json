{
	"app-id": "org.wxformbuilder.wxFormBuilder",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "26.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "wxformbuilder",
	"finish-args": [
		"--socket=x11",
		"--socket=wayland",
		"--filesystem=host"
	],
	"cleanup": [ "/include" ],
	"modules": [
		{
			"name": "wxWidgets",
			"buildsystem": "autotools",
			"config-opts": [
				"--with-gtk=3",
				"--with-cxx=17",
				"--with-libiconv=/usr"
			],
			"sources": [
				{
					"type": "archive",
					"url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.3.4/wxWidgets-3.3.4.tar.bz2",
					"sha256": "815c16cafa4fcbfcf25c5c0a3418309c62257b8a3b6f91d85a1367a134f98c98"
				}
			],
			"cleanup": [ "/bin/wx*", "/lib/wx" ]
		},
		{
			"name": "Boost",
			"buildsystem": "simple",
			"build-commands": [
				"./bootstrap.sh",
				"./b2 --prefix=$FLATPAK_DEST --build-dir=./build --with-headers install"
			],
			"sources": [
				{
					"type": "archive",
					"url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
					"sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
				}
			],
			"cleanup": [ "/lib/cmake" ]
		},
		{
			"name": "wxFormBuilder",
			"buildsystem": "cmake",
			"config-opts": [
				"-DCMAKE_BUILD_TYPE=Release"
			],
			"sources": [
				{
					"type": "dir",
					"path": "../../../../"
				}
			]
		}
	]
}
